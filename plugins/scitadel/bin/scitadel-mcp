#!/usr/bin/env bash
# Scitadel MCP launcher (Claude Code plugin).
#
# On first launch this fetches the pinned scitadel release binary for the host
# platform from GitHub Releases, verifies its SHA-256, caches it next to this
# script, then execs `scitadel mcp`. Later launches exec the cached binary.
#
# Resolution order:
#   1. $SCITADEL_BIN, if set and executable        (explicit override)
#   2. cached release binary  bin/scitadel-<version> (fast path)
#   3. download+verify the pinned release, then cache and exec
#   4. `scitadel` on PATH                            (cargo install / nix fallback)
#
# CRITICAL: stdout is the MCP JSON-RPC channel. Every diagnostic MUST go to
# stderr (>&2). Only the final `exec` may write to stdout.
set -euo pipefail

REPO="vig-os/scitadel"
ROOT="${CLAUDE_PLUGIN_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
BIN_DIR="$ROOT/bin"
VERSION="$(tr -d '[:space:]' < "$BIN_DIR/VERSION")"
BIN="$BIN_DIR/scitadel-$VERSION"

log() { printf '[scitadel-mcp] %s\n' "$*" >&2; }
die() { log "ERROR: $*"; exit 1; }

# 1. Explicit override (dev: point at target/debug/scitadel, etc.).
if [[ -n "${SCITADEL_BIN:-}" && -x "${SCITADEL_BIN:-}" ]]; then
  exec "$SCITADEL_BIN" "$@"
fi

# 2. Fast path: cached binary present.
if [[ -x "$BIN" ]]; then
  exec "$BIN" "$@"
fi

# Fall back to a PATH-resolved `scitadel` (cargo install / homebrew / nix).
fallback_path() {
  if command -v scitadel >/dev/null 2>&1; then
    log "using scitadel from PATH ($(command -v scitadel))"
    exec scitadel "$@"
  fi
}

# 3. Determine target triple for the prebuilt release.
os="$(uname -s)"; arch="$(uname -m)"
case "$os/$arch" in
  Darwin/arm64)   target="aarch64-apple-darwin" ;;
  Darwin/x86_64)  target="x86_64-apple-darwin" ;;
  Linux/x86_64)   target="x86_64-unknown-linux-gnu" ;;
  *)
    log "no prebuilt scitadel binary for $os/$arch."
    fallback_path "$@"
    die "unsupported platform $os/$arch and no \`scitadel\` on PATH. Install with: cargo install scitadel-cli"
    ;;
esac

tarball="scitadel-$VERSION-$target.tar.gz"
url="https://github.com/$REPO/releases/download/$VERSION/$tarball"

fetch() {
  if command -v curl >/dev/null 2>&1; then curl -fsSL "$1" -o "$2"
  elif command -v wget >/dev/null 2>&1; then wget -qO "$2" "$1"
  else return 127; fi
}
sha256() {
  if command -v shasum >/dev/null 2>&1; then shasum -a 256 "$1" | awk '{print $1}'
  elif command -v sha256sum >/dev/null 2>&1; then sha256sum "$1" | awk '{print $1}'
  else echo ""; fi
}

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

log "fetching scitadel $VERSION for $target ..."
if ! fetch "$url" "$tmp/$tarball"; then
  log "download failed: $url"
  fallback_path "$@"
  die "could not fetch the scitadel release and no \`scitadel\` on PATH. Install with: cargo install scitadel-cli"
fi

# Verify checksum against the .sha256 sidecar uploaded by binaries.yml.
if fetch "$url.sha256" "$tmp/$tarball.sha256" 2>/dev/null; then
  want="$(awk '{print $1}' "$tmp/$tarball.sha256")"
  got="$(sha256 "$tmp/$tarball")"
  if [[ -z "$got" ]]; then
    log "WARNING: no shasum/sha256sum available; skipping checksum verification"
  elif [[ "$want" != "$got" ]]; then
    die "checksum mismatch for $tarball (want $want, got $got)"
  else
    log "checksum ok"
  fi
else
  log "WARNING: no .sha256 sidecar for $tarball; skipping verification"
fi

tar -xzf "$tmp/$tarball" -C "$tmp" || die "failed to extract $tarball"
src="$tmp/scitadel-$VERSION-$target/scitadel"
[[ -f "$src" ]] || die "binary not found in tarball at scitadel-$VERSION-$target/scitadel"

mkdir -p "$BIN_DIR"
# Atomic install: stage with a unique name, then rename into place.
mv "$src" "$BIN.tmp.$$"
chmod +x "$BIN.tmp.$$"
mv "$BIN.tmp.$$" "$BIN"
log "installed -> $BIN"

exec "$BIN" "$@"
